# ProCash - exemplo de configuracao de ambiente
# Copie este arquivo para .env e ajuste os valores para o ambiente local.
# NUNCA coloque senhas, certificados, chaves privadas ou valores reais neste arquivo versionado.

# Obrigatorio em producao. Gere um valor novo e secreto para cada ambiente.
SECRET_KEY=CHANGE_ME_GENERATE_A_NEW_SECRET_KEY

# development ou production
ENVIRONMENT=development

# Hosts separados por virgula.
ALLOWED_HOSTS=127.0.0.1,localhost

# Origens confiaveis separadas por virgula.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Opcional.
# Se omitida, o armazenamento A1 usa BASE_DIR/certificados.
# Em producao, prefira um diretorio privado fora da arvore publica/aplicacao.
PROCASH_CERTIFICADOS_A1_DIR=
